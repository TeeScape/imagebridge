#!/usr/bin/env bash
# codex-image — generate an image with the Codex CLI's built-in $imagegen skill
# and print the absolute path of the saved file on stdout.
#
#   IMG=$(codex-image "a tiny orange robot watering a houseplant" -o out/robot.png)
#
# Runs on the signed-in ChatGPT plan (no OPENAI_API_KEY). Codex always writes
# its generations to $CODEX_HOME/generated_images/<session>/; this script picks
# the files produced by *this* run from there and places them itself, so the
# output path never depends on the model following instructions.

set -uo pipefail

usage() {
  cat <<'USAGE'
codex-image [options] "<image description>"

Options
  -o, --out FILE        exact output path (parent dir is created)
  -d, --dir DIR         output directory; filename derived from the description
                        (default: current directory)
  -r, --ref FILE        edit this existing image, or use it as a reference
                        (repeatable, at most 16). This is a real edit: the
                        shape and composition are preserved.
      --from-last N     edit the last N images of the Codex conversation
                        (1-5) instead of a local file
  -m, --model MODEL     Codex model driving the generation
  -a, --all             keep every image this run produced, not just the newest
  -t, --transparent     ask for a transparent background (PNG)
      --gif             ask for an animated GIF instead of a still image
      --no-clobber      never overwrite; add -2, -3 ... instead
      --dry-run         print the exact codex command and exit, generating nothing
      --user-config     load ~/.codex/config.toml (off by default)
  -v, --verbose         print the Codex transcript to stderr
  -h, --help            this help

Note: the size and aspect ratio cannot be set on this path — Codex's image tool
takes no size argument. Wording like "square icon" or "wide banner" steers it,
but nothing guarantees it. Use openai-image when a size is required.

stdout: one absolute path per line. Exit non-zero if nothing was generated.

Examples
  codex-image "flat vector icon of a blue folder, white background" -o assets/folder.png
  codex-image "the same robot, now at night" -r out/robot.png -d out
USAGE
}

OUT=""; DIR=""; MODEL=""; USER_CONFIG=0; VERBOSE=0; ALL=0; REFS=(); FROM_LAST=""
TRANSPARENT=0; GIF=0; DRY_RUN=0; NO_CLOBBER=0

POSITIONAL=()
while [ $# -gt 0 ]; do
  case "$1" in
    -o|--out)      OUT="${2:?--out needs a value}"; shift 2 ;;
    -d|--dir)      DIR="${2:?--dir needs a value}"; shift 2 ;;
    -r|--ref)      REFS+=("${2:?--ref needs a value}"); shift 2 ;;
    -m|--model)    MODEL="${2:?--model needs a value}"; shift 2 ;;
    --from-last)   FROM_LAST="${2:?--from-last needs a value}"; shift 2 ;;
    -a|--all)      ALL=1; shift ;;
    -t|--transparent) TRANSPARENT=1; shift ;;
    --gif)         GIF=1; shift ;;
    --no-clobber)  NO_CLOBBER=1; shift ;;
    --dry-run)     DRY_RUN=1; shift ;;
    --user-config) USER_CONFIG=1; shift ;;
    -v|--verbose)  VERBOSE=1; shift ;;
    -h|--help)     usage; exit 0 ;;
    --)            shift; while [ $# -gt 0 ]; do POSITIONAL+=("$1"); shift; done ;;
    -*)            echo "codex-image: unknown option: $1" >&2; exit 2 ;;
    *)             POSITIONAL+=("$1"); shift ;;
  esac
done
set -- ${POSITIONAL+"${POSITIONAL[@]}"}

DESC="${1:-}"
if [ -z "$DESC" ]; then usage >&2; exit 2; fi
if [ $# -gt 1 ]; then
  echo "codex-image: got $# separate arguments; quote the whole text as one argument." >&2
  exit 2
fi

command -v codex >/dev/null 2>&1 || {
  echo "codex-image: 'codex' not found. Install: brew install --cask codex" >&2; exit 127; }

GEN_ROOT="${CODEX_HOME:-$HOME/.codex}/generated_images"

# Where the finished file(s) should end up.
if [ -n "$OUT" ]; then
  mkdir -p "$(dirname "$OUT")" || exit 1
  DEST_DIR=$(cd "$(dirname "$OUT")" && pwd)
  DEST_NAME=$(basename "$OUT")
  FIXED_NAME=1
else
  DIR="${DIR:-.}"
  mkdir -p "$DIR" || exit 1
  DEST_DIR=$(cd "$DIR" && pwd)
  # Slug from the first words of the description. Only characters that are
  # unsafe in a filename are replaced, so a Thai (or any non-ASCII) description
  # keeps its own words instead of collapsing to a generic name. The length is
  # capped by whole words, never mid-character.
  DEST_NAME=$(printf '%s' "$DESC" | tr '[:upper:]' '[:lower:]' \
    | sed -e 's@[][/\\:*?"<>|`$()&;!'"'"']@ @g' \
          -e 's/[[:space:]][[:space:]]*/-/g' -e 's/--*/-/g' \
          -e 's/^-//' -e 's/-$//' \
    | awk -F- '{ n = (NF > 8 ? 8 : NF); out = $1; for (i = 2; i <= n; i++) out = out "-" $i; print out }')
  [ -z "$DEST_NAME" ] && DEST_NAME="codex-image"
  DEST_NAME="$DEST_NAME.png"
  FIXED_NAME=0
fi

# GNU mktemp requires a template ending in XXX; BSD's `-t prefix` does not work
# there at all, so spell the template out. This used to kill the script on Linux
# before codex was ever invoked.
SCRATCH=$(mktemp -d "${TMPDIR:-/tmp}/codex-image.XXXXXXXX") || {
  echo "codex-image: could not create a temporary directory" >&2; exit 1; }
LOG="$SCRATCH/transcript.log"
STAMP="$SCRATCH/stamp"
KEEP_LOG_AT=""
: >"$LOG"; : >"$STAMP"
cleanup() {
  if [ -n "$KEEP_LOG_AT" ] && [ -f "$LOG" ]; then cp "$LOG" "$KEEP_LOG_AT" 2>/dev/null; fi
  rm -rf "$SCRATCH"
}
trap cleanup EXIT

# The agent only has to generate; placement is this script's job. It gets a
# throwaway workspace so a stray file never lands in the caller's project.
# Codex's image tool takes `referenced_image_paths` for edits — its own
# instructions say "For edits, use referenced_image_paths when every target
# image has a local file path". Naming the paths in the prompt is what makes
# the model pass them, and it preserves the original: a measured edit of a
# 1254x1254 icon came back 1254x1254 with a silhouette IoU of 1.000.
EXTRA=""
if [ ${#REFS[@]} -gt 0 ]; then
  if [ ${#REFS[@]} -gt 16 ]; then
    echo "codex-image: at most 16 reference images, got ${#REFS[@]}" >&2; exit 2
  fi
  LIST=""
  for f in "${REFS[@]}"; do
    [ -f "$f" ] || { echo "codex-image: reference image not found: $f" >&2; exit 1; }
    # -P so the path is physical: on macOS /var/folders is a symlink to
    # /private/var/folders, and `cd` alone reports whichever form it was given.
    abs=$(cd -P "$(dirname "$f")" && pwd)/$(basename "$f")
    LIST="$LIST
$abs"
  done
  EXTRA="$EXTRA
Edit the existing image(s) below rather than drawing something new. Pass every
one of these through referenced_image_paths, and change only what the request
asks for — keep the composition, size and everything else as it is:$LIST"
fi
if [ -n "$FROM_LAST" ]; then
  if [ ${#REFS[@]} -gt 0 ]; then
    echo "codex-image: use either --ref or --from-last, never both" >&2; exit 2
  fi
  case "$FROM_LAST" in
    [1-5]) ;;
    *) echo "codex-image: --from-last must be between 1 and 5" >&2; exit 2 ;;
  esac
  EXTRA="$EXTRA
Edit the most recent image(s) of this conversation: set
num_last_images_to_include to $FROM_LAST. Change only what the request asks for."
fi
[ "$TRANSPARENT" -eq 1 ] && EXTRA="$EXTRA
Use a transparent background (transparent_background), and output PNG."
[ "$GIF" -eq 1 ] && EXTRA="$EXTRA
Produce an animated GIF (gif), not a still image."

PROMPT="\$imagegen $DESC$EXTRA

Generate the image. Do not ask questions, do not write any other files, do not
copy or move the result. When the image exists, reply with only its absolute path."

ARGS=(exec --skip-git-repo-check --sandbox workspace-write -C "$SCRATCH")
[ "$USER_CONFIG" -eq 1 ] || ARGS+=(--ignore-user-config)
[ -n "$MODEL" ] && ARGS+=(-m "$MODEL")
# The reference images are named in the prompt (referenced_image_paths), not
# attached with `codex exec -i`: that flag is a vision attachment, a different
# mechanism that costs more tokens and does not drive the edit path.
ARGS+=(-- "$PROMPT")

if [ "$DRY_RUN" -eq 1 ]; then
  # Machine-readable first, so a caller never has to reverse-engineer how %q
  # chose to quote things, then the command itself for a human to read.
  for f in ${REFS+"${REFS[@]}"}; do
    printf 'referenced: %s\n' "$(cd -P "$(dirname "$f")" && pwd)/$(basename "$f")"
  done
  [ -n "$FROM_LAST" ] && printf 'from-last: %s\n' "$FROM_LAST"
  [ "$TRANSPARENT" -eq 1 ] && printf 'transparent: yes\n'
  [ "$GIF" -eq 1 ] && printf 'gif: yes\n'
  printf 'command: codex'
  for a in "${ARGS[@]}"; do printf ' %q' "$a"; done
  printf '\n'
  exit 0
fi

codex "${ARGS[@]}" </dev/null >"$LOG" 2>&1
RC=$?
[ "$VERBOSE" -eq 1 ] && cat "$LOG" >&2

# Collect what this run generated, newest first.
FOUND="$SCRATCH/found"
: >"$FOUND"
# NOTE: never pipe straight into xargs here. With no matches, GNU xargs still
# runs `ls -t` once, which lists the CURRENT DIRECTORY — a failed run would then
# copy a random project file and report it as the generated image. Writing the
# matches to a file and testing it first removes that hazard on every platform.
RAW="$SCRATCH/found.raw"
: >"$RAW"
if [ -d "$GEN_ROOT" ]; then
  find "$GEN_ROOT" -type f -newer "$STAMP" \
    \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*.gif' \) \
    -print0 >"$RAW" 2>/dev/null
fi
if [ -s "$RAW" ]; then
  xargs -0 ls -t <"$RAW" >"$FOUND" 2>/dev/null
fi

if [ "$RC" -ne 0 ]; then
  # Previously a stray newer file could make a failed run look like a success.
  KEEP_LOG_AT="$DEST_DIR/codex-image-failure.log"
  echo "codex-image: codex exited $RC — treating this run as failed." >&2
  echo "--- codex transcript (also saved to $KEEP_LOG_AT) ---" >&2
  cat "$LOG" >&2
  exit "$RC"
fi

if [ ! -s "$FOUND" ]; then
  KEEP_LOG_AT="$DEST_DIR/codex-image-failure.log"
  echo "codex-image: no image was generated (codex exit $RC)." >&2
  echo "--- codex transcript (also saved to $KEEP_LOG_AT) ---" >&2
  cat "$LOG" >&2
  exit 1
fi

[ "$ALL" -eq 1 ] || { head -n 1 "$FOUND" >"$FOUND.one"; mv "$FOUND.one" "$FOUND"; }

i=0
while IFS= read -r src; do
  [ -n "$src" ] || continue
  ext="${src##*.}"
  base="${DEST_NAME%.*}"
  if [ "$FIXED_NAME" -eq 1 ]; then
    case "$DEST_NAME" in
      *.*) dext="${DEST_NAME##*.}" ;;
      *)   dext="$ext"; base="$DEST_NAME" ;;   # `-o myicon` must not become myicon.myicon
    esac
    if [ "$dext" != "$ext" ]; then
      echo "codex-image: codex returned .$ext; saving with the .$dext name you asked for" >&2
    fi
  else
    dext="$ext"
  fi
  i=$((i+1))
  cand="$DEST_DIR/$base.$dext"
  [ "$i" -gt 1 ] && cand="$DEST_DIR/$base-$i.$dext"
  # An explicit -o names one path and means it: overwrite, unless --no-clobber.
  # Without -o the name is derived, so never destroy an unrelated file.
  if [ "$FIXED_NAME" -eq 0 ] || [ "$NO_CLOBBER" -eq 1 ] || [ "$i" -gt 1 ]; then
    n=2
    while [ -e "$cand" ]; do cand="$DEST_DIR/$base-$n.$dext"; n=$((n+1)); done
  fi
  cp "$src" "$cand" || exit 1
  printf '%s\n' "$cand"
done <"$FOUND"
